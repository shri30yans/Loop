# AI Provider Configuration
API_KEY=your_api_key_here
API_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4

# Embedding Model Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Backend Configuration
# This should match the Loop_backend service URL and authentication
GO_BACKEND_URL=http://localhost:8080
GO_BACKEND_API_TOKEN=your_api_token_here

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# WebSocket Configuration
SOCKET_PING_TIMEOUT=60
SOCKET_PING_INTERVAL=25

# Deep Search Configuration
DEFAULT_DEEP_SEARCH=false
MAX_DEEP_SEARCH_RESULTS=5

# Copy this file to .env and update the values
# cp .env.example .env
