# Server Configuration
SERVER_PORT=8080
SERVER_HOST=localhost

# Database Configuration
# PostgreSQL connection string (required)
DB_CONN_STRING=postgresql://username:password@localhost:5432/loop_db

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Authentication
JWT_SECRET=your_jwt_secret_here

# AI Provider Configuration
# Options: openai-compatible, ollama
AI_PROVIDER=openai-compatible

# OpenAI-compatible Configuration
API_KEY=your_api_key_here
API_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4

# Python Embedding Service Configuration
# This should point to the Loop_agent service
PYTHON_EMBEDDING_URL=http://localhost:5000

# Copy this file to .env and update the values
# cp .env.example .env